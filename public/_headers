# Cloudflare Pages headers.
#
# This file must live in `public/` (so Vite copies it to `dist/`) — Pages only
# reads `_headers` from the *uploaded output directory*, never the repo root.
#
# Rule order matters only in that the FIRST matching rule wins for a given
# header; do not stack two Cache-Control rules on the same path or you get
# concatenated directives (`public, max-age=31536000, immutable, public,
# max-age=0`) and RFC 9111 says caches may then treat the response as stale.

# --- Hashed build output: cache for a year -------------------------------
# Vite writes /assets/* with a content hash in the filename, so a URL can never
# change meaning. Safe to cache immutably.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# --- Fonts -----------------------------------------------------------------
# NOT hashed: /fonts/inter-latin.woff2 has a stable name. If you ever swap the
# file in place, a 1-year immutable cache pins returning visitors to the old
# bytes with no way to bust it. Hence a week + stale-while-revalidate rather
# than the usual immutable. Rename the file when the font changes.
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# --- HTML shell: always revalidate ----------------------------------------
# A stale index.html is the worst failure mode available: it references old
# asset hashes, so the app loads a bundle that no longer exists.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# --- Unhashed static files: short-lived -----------------------------------
# These change rarely but are not fingerprinted, so they cannot be immutable.
/favicon.svg
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/og-image.jpg
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

# --- Security headers ------------------------------------------------------
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# --- Do not index preview / branch deploys --------------------------------
# Every push to a non-production branch gets its own *.pages.dev URL. Indexed
# duplicates of a marketing site split ranking and are painful to remove.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
