# Server-side only. Never prefix these with VITE_ — anything that starts with
# VITE_ is inlined into the client bundle at build time.
#
# Local dev:  KAIRVEN_WHATSAPP_NUMBER=919999999999 npm run dev
# Production: npx wrangler pages secret put KAIRVEN_WHATSAPP_NUMBER --project-name kairven

# Digits only, with country code, no "+" and no spaces.
KAIRVEN_WHATSAPP_NUMBER=

# Optional: send via the Meta WhatsApp Cloud API instead of a wa.me deep link.
# KAIRVEN_WA_TOKEN=
# KAIRVEN_WA_PHONE_ID=
